<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tiago_adapters</name>
  <version>0.0.0</version>
  <description>ROS 2 adapters for CASPER_MAS robots</description>
  <maintainer email="leticia.berto@manchester.ac.uk">Leticia Berto</maintainer>
  <license>Apache-2.0</license>

  <export>
    <build_type>ament_python</build_type>
  </export>

  <!-- Core ROS2 -->
  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>

  <!-- Messages used in the data contract and trajectories -->
  <depend>control_msgs</depend>        <!-- FollowJointTrajectory action -->
  <depend>trajectory_msgs</depend>     <!-- JointTrajectory, JointTrajectoryPoint -->
  <depend>geometry_msgs</depend>       <!-- Pose, PoseStamped, Quaternion, Point -->
  <depend>sensor_msgs</depend>         <!-- JointState (arm completion detection) -->
  <depend>std_msgs</depend>            <!-- Header (Nav2 goal stamp) -->

  <!-- Ignition Fortress scene awareness (bridged via ros_gz_bridge) -->
  <depend>tf2_msgs</depend>            <!-- TFMessage from dynamic_pose bridge -->

  <!-- URDF / package path lookup -->
  <depend>ament_index_python</depend>  <!-- get_package_share_directory for URDF -->

  <!-- Shared utilities for all robot adapters -->
  <depend>robot_common</depend>

  <exec_depend>ros2launch</exec_depend>

</package>
