<sdf version="1.7">
  <world name="backyard_world">

    <!-- Scene -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.9 1 1</background>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 12 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 12 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fences -->
    <model name="backyard_perimeter">
      <static>true</static>
      <link name="link">

        <collision name="back_col">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <pose>0 6 1 0 0 0</pose>
        </collision>
        <visual name="back_vis">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <pose>0 6 1 0 0 0</pose>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>

        <collision name="left_col">
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <pose>-6 0 1 0 0 0</pose>
        </collision>
        <visual name="left_vis">
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <pose>-6 0 1 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>

        <collision name="right_col">
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <pose>6 0 1 0 0 0</pose>
        </collision>
        <visual name="right_vis">
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <pose>6 0 1 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- House -->
    <model name="house">
      <static>true</static>
      <pose>0 -7.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>12 3 3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>12 3 3</size></box></geometry>
          <material>
            <ambient>0.9 0.7 0.6 1</ambient>
            <diffuse>0.9 0.7 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Glass doors -->
    <model name="door_left">
      <static>true</static>
      <pose>-1 -6 1.25 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>2 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.9 1 0.5</ambient>
            <diffuse>0.7 0.9 1 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Grill -->
    <model name="door_right">
      <static>true</static>
      <pose>1 -6 1.25 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>2 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.9 1 0.5</ambient>
            <diffuse>0.7 0.9 1 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="grill">
      <static>true</static>
      <pose>5 4.58 0 0 0 0</pose> <!-- base at ground -->
      <link name="link">
        <!-- collision representing top surface -->
        <collision name="top">
          <geometry><box><size>0.8 0.8 0.05</size></box></geometry>
          <pose>0 0 0.85 0 0 0</pose> <!-- top of collision at 0.85m -->
        </collision>
        
        <!-- visual cylinder for appearance -->
        <visual name="vis">
          <geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry>
          <pose>0 0 0.45 0 0 0</pose> <!-- visually correct grill height -->
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Prep Grill table -->
    <model name="prep_grill">
      <static>true</static>
      <pose>4.9 5.4 0 0 0 0</pose>
      <link name="link">
        <collision name="c_top">
          <geometry><box><size>1.8 0.8 0.05</size></box></geometry>
          <pose>0 0 0.85 0 0 0</pose>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.8 0.8 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Prep table -->
    <model name="prep">
      <static>true</static>
      <pose>1 5.1 0 0 0 0</pose>
      <link name="link">
        <collision name="c_top">
          <geometry><box><size>2.5 1.5 0.05</size></box></geometry>
          <pose>0 0 0.85 0 0 0</pose>
        </collision>
        <visual name="vis">
          <geometry><box><size>2.5 1.5 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dining Table Left -->
    <model name="table_left">
      <static>true</static>
      <pose>-3 -1.5 0 0 0 0</pose>
      <link name="l">
        <collision name="c_top">
          <geometry><box><size>4 1 0.05</size></box></geometry>
          <pose>0 0 0.85 0 0 0</pose>
        </collision>
        <visual name="v">
          <geometry><box><size>4 1 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Benches -->
    <model name="bench_l1">
      <static>true</static>
      <pose>-3 -2.3 0 0 0 0</pose>
      <link name="l">
        <collision name="c">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name="v">
          <geometry><box><size>4 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bench_l2">
      <static>true</static>
      <pose>-3 -0.7 0 0 0 0</pose>
      <link name="l">
        <collision name="c">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name="v">
          <geometry><box><size>4 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- FOOD AS MODELS ABOVE TABLES -->

    <!-- Meat on Grill -->
    <include>
      <uri>model://meat</uri>
      <pose>5 4.7 0.86 0 0 0</pose> <!-- half meat height above collision -->
    </include>
    <include>
      <uri>model://meat</uri>
      <name>meat_2</name>
      <pose>5.2 4.7 0.86 0 0 0</pose>
    </include>
    <include>
      <uri>model://meat</uri>
      <name>meat_3</name>
      <pose>4.8 4.7 0.86 0 0 0</pose>
    </include>

    <!-- Pao de alho on Grill -->
    <include>
      <uri>model://pao_de_alho</uri>
      <name>pao_de_alho</name>
      <pose>5.1 4.5 0.86 0 0 0</pose>
    </include>
    <include>
      <uri>model://pao_de_alho</uri>
      <name>pao_de_alho_2</name>
      <pose>4.9 4.5 0.86 0 0 0</pose>
    </include>

    <!-- Plate on Grill Prep Table -->
    <include>
      <uri>model://plate</uri>
      <pose>4.3 5.4 0.85 0 0 0</pose> 
    </include>

    <!-- Tomato on Prep Table -->
    <include>
      <uri>model://tomato</uri>
      <pose>1 5.2 0.95 0 0 0</pose>
    </include>
    <include>
      <uri>model://tomato</uri>
      <name>tomato_2</name>
      <pose>1.2 5 0.95 0 0 0</pose>
    </include>
    <include>
      <uri>model://tomato</uri>
      <name>tomato_3</name>
      <pose>1 5 0.95 0 0 0</pose>
    </include>

    <!-- Carrot on Prep Table -->
    <include>
      <uri>model://carrot</uri>
      <pose>1.1 5.3 0.95 0 1.57 0</pose>
    </include>

    <!-- Cucumber on Prep Table -->
    <include>
      <uri>model://cucumber</uri>
      <pose>1.3 5.1 0.95 0 1.57 0</pose>
    </include>

    <!-- Bowl on Prep Table -->
    <include>
      <uri>model://bowl</uri>
      <pose>0.7 4.7 0.93 0 0 0</pose> <!-- on table -->
    </include>

  </world>
</sdf>