<?xml version='1.0'?>
<sdf version="1.7">
  <world name="backyard_world">

    <!-- DART is faster than Bullet for articulated robots in Ignition Fortress -->
    <physics name='default_physics' type='dart'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics"         filename="ignition-gazebo-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands"    filename="ignition-gazebo-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact"         filename="ignition-gazebo-contact-system"/>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <!-- Scene -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.9 1 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- ================================================================
         GROUND — plane geometry, not box.
         DART resolves plane contacts with a single half-space constraint,
         far cheaper than box face/edge contacts.
    ================================================================ -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>12 12</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         FENCES — visual only, no collision.
         Robot will never reach the perimeter.
    ================================================================ -->
    <model name="backyard_perimeter">
      <static>true</static>
      <link name="link">

        <visual name="back_vis">
          <pose>0 6 1 0 0 0</pose>
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>

        <visual name="left_vis">
          <pose>-6 0 1 0 0 0</pose>
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>

        <visual name="right_vis">
          <pose>6 0 1 0 0 0</pose>
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>

      </link>
    </model>

    <!-- ================================================================
         HOUSE — visual only, no collision.
    ================================================================ -->
    <model name="house">
      <static>true</static>
      <pose>0 -7.5 1.5 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>12 3 3</size></box></geometry>
          <material><ambient>0.9 0.7 0.6 1</ambient><diffuse>0.9 0.7 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Glass doors — visual only -->
    <model name="door_left">
      <static>true</static>
      <!-- <pose>-1 -6 1.25 0 0 0</pose> -->
      <pose>0 -6 1.25 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>4 0.1 2.5</size></box></geometry>
          <material><ambient>0.7 0.9 1 0.5</ambient><diffuse>0.7 0.9 1 0.5</diffuse></material>
        </visual>
      </link>
    </model>

<!--     <model name="door_right">
      <static>true</static>
      <pose>1 -6 1.25 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>2 0.1 2.5</size></box></geometry>
          <material><ambient>0.7 0.9 1 0.5</ambient><diffuse>0.7 0.9 1 0.5</diffuse></material>
        </visual>
      </link>
    </model> -->

    <!-- ================================================================
         GRILL — collision on top surface only, plus visual.
    ================================================================ -->
    <model name="grill">
      <static>true</static>
      <pose>5 4.58 0 0 0 0</pose>
      <link name="link">
        <collision name="top">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.05</size></box></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         TABLES — top surface collision only, no leg/side collisions.
         Static bodies against DART are cheap; only the top face matters
         for supporting food items.
         BENCHES — visual only, robot and food never interact with them.
    ================================================================ -->
    <model name="prep_grill">
      <static>true</static>
      <pose>4.9 5.4 0 0 0 0</pose>
      <link name="link">
        <collision name="top">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>1.8 0.8 0.05</size></box></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><box><size>1.8 0.8 0.1</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="prep">
      <static>true</static>
      <pose>1 5.3 0 0 0 0</pose>
      <link name="link">
        <collision name="top">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>2 1.1 0.05</size></box></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><box><size>2 1.1 0.1</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table_right">
      <static>true</static>
      <pose>-3 -1.5 0 0 0 0</pose>
      <link name="r">
        <collision name="top">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>4 1 0.05</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><box><size>4 1 0.1</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bench_r1">
      <static>true</static>
      <pose>-3 -2.3 0 0 0 0</pose>
      <link name="r">
        <visual name="v">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>4 0.4 0.1</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bench_r2">
      <static>true</static>
      <pose>-3 -0.7 0 0 0 0</pose>
      <link name="r">
        <visual name="v">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>4 0.4 0.1</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         FOOD, PLATE, BOWL — dynamic, pickable.

         Sleep thresholds let DART remove them from the active solver
         once they settle. They wake automatically on gripper contact.

         Z positions account for the ground plane (z=0) directly since
         tables have no collision — set each item's z to its resting
         height above the real ground (table height + half item height).
         Grill top: ~0.86m. Prep table top: ~0.85m.
    ================================================================ -->

    <!-- Grill surface z=0.86 -->
    <include>
      <uri>model://meat</uri>
      <name>meat_1</name>
      <pose>5 4.7 0.86 0 0 0</pose>
    </include>
    <include>
      <uri>model://meat</uri>
      <name>meat_2</name>
      <pose>5.2 4.7 0.86 0 0 0</pose>
    </include>
    <include>
      <uri>model://meat</uri>
      <name>meat_3</name>
      <pose>4.8 4.7 0.86 0 0 0</pose>
    </include>

    <include>
      <uri>model://garlic_bread</uri>
      <name>garlic_bread_1</name>
      <pose>5.1 4.5 0.86 0 0 0</pose>
    </include>
    <include>
      <uri>model://garlic_bread</uri>
      <name>garlic_bread_2</name>
      <pose>4.9 4.5 0.86 0 0 0</pose>
    </include>

    <!-- Grill prep table surface z=0.85 -->
    <include>
      <uri>model://plate</uri>
      <name>plate_1</name>
      <pose>4.3 5.2 0.85 0 0 0</pose>
    </include>

    <!-- Prep table surface z=0.85 -->
    <include>
      <uri>model://tomato</uri>
      <name>tomato_1</name>
      <pose>1 5.2 0.95 0 0 0</pose>
    </include>
    <include>
      <uri>model://tomato</uri>
      <name>tomato_2</name>
      <pose>1.2 5 0.95 0 0 0</pose>
    </include>
    <include>
      <uri>model://tomato</uri>
      <name>tomato_3</name>
      <pose>1 5 0.95 0 0 0</pose>
    </include>

    <include>
      <uri>model://purple_onion</uri>
      <name>purple_onion_1</name>
      <pose>1.2 5.2 0.95 0 0 0</pose>
    </include>

    <include>
      <uri>model://carrot</uri>
      <name>carrot_1</name>
      <pose>1.7 5.3 0.95 0 0 0</pose>
    </include>

    <include>
      <uri>model://carrot</uri>
      <name>carrot_2</name>
      <pose>0.7 5.25 0.95 0 0 0</pose>
    </include>

    <include>
      <uri>model://cucumber</uri>
      <name>cucumber_1</name>
      <pose>0.5 5.25 0.95 0 0 0</pose>
    </include>

    <include>
      <uri>model://cucumber</uri>
      <name>cucumber_2</name>
      <pose>1.4 5.3 0.95 0 0 0</pose>
    </include>

    <include>
      <uri>model://bowl</uri>
      <name>bowl_1</name>
      <pose>0.6 4.9 0.93 0 0 0</pose>
    </include>

    <include>
      <uri>model://bowl</uri>
      <name>bowl_2</name>
      <pose>1.5 4.9 0.93 0 0 0</pose>
    </include>


    <!-- Table with drinks-->
    <model name="drink_table">
      <static>true</static>
      <pose>-5.2 5.4 0 0 0 0</pose>
      <link name="link">
        <collision name="top">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.5 0.5 0.05</size></box></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><box><size>0.5 0.5 0.1</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://drink</uri>
      <name>drink_1</name>
      <pose>-5 5.6 0.9 0 0 0</pose>
    </include>

    <include>
      <uri>model://drink</uri>
      <name>drink_2</name>
      <pose>-5.2 5.4 0.9 0 0 0</pose>
    </include>

    <include>
      <uri>model://drink</uri>
      <name>drink_3</name>
      <pose>-5 5.2 0.9 0 0 0</pose>
    </include>

    <include>
      <uri>model://drink</uri>
      <name>drink_4</name>
      <pose>-5.4 5.2 0.9 0 0 0</pose>
    </include>

  </world>
</sdf>