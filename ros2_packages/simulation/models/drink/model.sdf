<?xml version="1.0" ?>
<sdf version="1.8">
  <!--
    Geometry  : cylinder  radius = 0.033 m,  length = 0.12 m
    Link origin: CENTRE of the cylinder  (SDFormat default — no child pose offset)

    Bottom of can = link-z − 0.06 m
    Top    of can = link-z + 0.06 m

    Placement : world pose z = table_surface_z + 0.06
                            = 0.85 + 0.06 = 0.910 m
    Visual == Collision  ✓  (identical geometry, no offset on either)
  -->
  <model name="drink">
    <static>false</static>
    <link name="can_link">

      <inertial>
        <mass>0.35</mass>
        <inertia>
          <!-- Solid cylinder: ixx=iyy=(1/12)*m*(3r²+h²), izz=(1/2)*m*r² -->
          <ixx>0.000581</ixx>
          <iyy>0.000581</iyy>
          <izz>0.000190</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.0 0.8 1</ambient>
          <diffuse>0.0 0.0 1.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

    </link>
  </model>
</sdf>
