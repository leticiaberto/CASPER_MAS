<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fr3_adapters</name>
  <version>0.0.0</version>
  <description>ROS 2 adapters for CASPER_MAS robots</description>
  <maintainer email="leticia.berto@manchester.ac.uk">Leticia Berto</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

  <!--<depend>moveit_msgs</depend>--> <!-- Not used — we talk directly to the controller, not MoveIt --> 

  <depend>rclpy</depend> <!-- Core ROS2 Python runtime -->
  <depend>control_msgs</depend> <!-- FollowJointTrajectory action -->
  <depend>trajectory_msgs</depend> <!-- JointTrajectory, JointTrajectoryPoint -->
  <depend>builtin_interfaces</depend> <!-- Duration (used in trajectory points) -->

  <!-- Shared utilities for all robot adapters -->
  <depend>robot_common</depend>

  <exec_depend>ros2launch</exec_depend>

</package>
