<sdf version="1.7">
  <world name="backyard_world">

    <!-- Scene lighting -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.9 1 1</background>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>12 12 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 12 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Backyard fences -->
    <model name="backyard_perimeter">
      <static>true</static>
      <link name="link">
        <!-- Back Fence -->
        <collision name="back_col">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <pose>0 6 1 0 0 0</pose>
        </collision>
        <visual name="back_vis">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <pose>0 6 1 0 0 0</pose>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>

        <!-- Left Fence -->
        <collision name="left_col">
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <pose>-6 0 1 0 0 0</pose>
        </collision>
        <visual name="left_vis">
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <pose>-6 0 1 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>

        <!-- Right Fence -->
        <collision name="right_col">
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <pose>6 0 1 0 0 0</pose>
        </collision>
        <visual name="right_vis">
          <geometry><box><size>0.2 12 2</size></box></geometry>
          <pose>6 0 1 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small House -->
    <model name="house">
      <static>true</static>
      <pose>0 -7.5 1.5 0 0 0</pose>
      <link name="house_link">
        <collision name="house_col">
          <geometry>
            <box><size>12 3 3</size></box>
          </geometry>
        </collision>
        <visual name="house_vis">
          <geometry>
            <box><size>12 3 3</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.7 0.6 1</ambient>
            <diffuse>0.9 0.7 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Glass Sliding Door (half open) -->
    <!-- Left half = closed -->
    <model name="glass_door_left">
      <static>true</static>
      <pose>-1  -6 1.25 0 0 0</pose>
      <link name="door_link">
        <collision name="door_col">
          <geometry><box><size>2 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="door_vis">
          <geometry><box><size>2 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.9 1 0.5</ambient>
            <diffuse>0.7 0.9 1 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right half = open (slid to the side) -->
    <model name="glass_door_right">
      <static>true</static>
      <pose>1  -6 1.25 0 0 0</pose>
      <link name="door_link">
        <collision name="door_col">
          <geometry><box><size>2 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="door_vis">
          <geometry><box><size>2 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.9 1 0.5</ambient>
            <diffuse>0.7 0.9 1 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Backyard Objects -->

    <!-- Grill -->
    <model name="grill">
      <static>true</static>
      <pose>3 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Prep Table -->
    <model name="prep_table">
      <static>true</static>
      <pose>-2 1 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col">
          <geometry><box><size>1.5 0.8 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
        </collision>
        <visual name="top">
          <geometry><box><size>1.5 0.8 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sink -->
    <model name="sink">
      <static>true</static>
      <pose>-2 2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="base_col">
          <geometry><box><size>0.8 0.6 0.9</size></box></geometry>
        </collision>
        <visual name="base">
          <geometry><box><size>0.8 0.6 0.9</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dining Table -->
    <model name="dining_table">
      <static>true</static>
      <pose>0 3 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col">
          <geometry><box><size>2 1 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
        </collision>
        <visual name="top">
          <geometry><box><size>2 1 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Benches -->
    <model name="bench1">
      <static>true</static>
      <pose>0 2.2 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name="vis">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bench2">
      <static>true</static>
      <pose>0 3.8 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name="vis">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>