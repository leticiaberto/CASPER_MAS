<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="garlic_bread">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <!-- computed for box 0.15 x 0.08 x 0.08 -->
          <ixx>0.000213</ixx>
          <iyy>0.000523</iyy>
          <izz>0.000523</izz>
        </inertia>
      </inertial>

      <collision name="col">
        <geometry>
          <box>
            <size>0.15 0.08 0.08</size> <!-- wider than carrot/cucumber -->
          </box>
        </geometry>
      </collision>

      <visual name="vis">
        <geometry>
          <box>
            <size>0.15 0.08 0.08</size>
          </box>
        </geometry>
        <material>
          <!-- garlic_bread yellow -->
          <ambient>1 0.85 0.2 1</ambient>
          <diffuse>1 0.9 0.3 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>