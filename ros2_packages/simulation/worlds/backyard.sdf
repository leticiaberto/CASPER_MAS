<sdf version="1.7">
  <world name="backyard_world">

    <!-- Scene lighting -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.9 1 1</background>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10 10 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10 10 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Entrance Room -->
    <model name="entrance_room">
      <static>true</static>
      <pose>0 -6 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>4 4 0.1</size></box>
          </geometry>
        </collision>
        <visual name="floor">
          <geometry>
            <box><size>4 4 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gate -->
    <model name="gate">
      <static>true</static>
      <pose>0 -4 1 0 0 0</pose>
      <link name="link">

        <collision name="left_col">
          <geometry><box><size>0.2 1 2</size></box></geometry>
          <pose>-0.6 0 0 0 0 0</pose>
        </collision>

        <collision name="right_col">
          <geometry><box><size>0.2 1 2</size></box></geometry>
          <pose>0.6 0 0 0 0 0</pose>
        </collision>

        <visual name="left">
          <geometry><box><size>0.2 1 2</size></box></geometry>
          <pose>-0.6 0 0 0 0 0</pose>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

        <visual name="right">
          <geometry><box><size>0.2 1 2</size></box></geometry>
          <pose>0.6 0 0 0 0 0</pose>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Grill -->
    <model name="grill">
      <static>true</static>
      <pose>3 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Prep Table -->
    <model name="prep_table">
      <static>true</static>
      <pose>-2 1 0 0 0 0</pose>
      <link name="link">

        <collision name="top_col">
          <geometry><box><size>1.5 0.8 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
        </collision>

        <visual name="top">
          <geometry><box><size>1.5 0.8 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
          <material>
            <ambient>0.7 0.5 0.3 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Sink -->
    <model name="sink">
      <static>true</static>
      <pose>-2 2.5 0 0 0 0</pose>
      <link name="link">

        <collision name="base_col">
          <geometry><box><size>0.8 0.6 0.9</size></box></geometry>
        </collision>

        <visual name="base">
          <geometry><box><size>0.8 0.6 0.9</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Dining Table -->
    <model name="dining_table">
      <static>true</static>
      <pose>0 3 0 0 0 0</pose>
      <link name="link">

        <collision name="top_col">
          <geometry><box><size>2 1 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
        </collision>

        <visual name="top">
          <geometry><box><size>2 1 0.1</size></box></geometry>
          <pose>0 0 0.8 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Benches -->
    <model name="bench1">
      <static>true</static>
      <pose>0 2.2 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name="vis">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bench2">
      <static>true</static>
      <pose>0 3.8 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
        <visual name="vis">
          <geometry><box><size>2 0.4 0.1</size></box></geometry>
          <pose>0 0 0.5 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>