      <!-- FLOOR -->
      <visual name="floor_visual">
        <pose>0 0 -0.9 0 0 0</pose>
        <geometry>
          <box><size>0.8 0.75 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>

      <!-- SHELF 1 (lighter grey) -->
      <collision name="shelf1_collision">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <box><size>0.7 0.65 0.02</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="shelf1_visual">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <box><size>0.7 0.65 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.92 0.92 0.92 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
        </material>
      </visual>

      <!-- SHELF 2 (lighter grey) -->
      <collision name="shelf2_collision">
        <pose>0 0 -0.35 0 0 0</pose>
        <geometry>
          <box><size>0.7 0.65 0.02</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
