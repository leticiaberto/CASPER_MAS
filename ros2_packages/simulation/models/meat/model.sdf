<?xml version="1.0" ?>
<sdf version="1.7">
  <!--
    Geometry  : box 0.05 m (X) × 0.10 m (Y) × 0.05 m (Z)
    Link origin: CENTRE of the box  (no rotation, no child offset)

    Bottom = link-z − 0.025 m
    Top    = link-z + 0.025 m

    Placement : world pose z = grill_surface_z + 0.025
                            = 0.86 + 0.025 = 0.885 m
    Visual == Collision  ✓
  -->
  <model name="meat">
    <link name="link">

      <inertial>
        <mass>0.20</mass>
        <inertia>
          <ixx>0.000208</ixx>   <!-- (1/12)*0.2*(0.10²+0.05²) -->
          <iyy>0.000042</iyy>   <!-- (1/12)*0.2*(0.05²+0.05²) -->
          <izz>0.000208</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.05 0.10 0.05</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>0.05 0.10 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.50 0.20 0.20 1</ambient>
          <diffuse>0.60 0.25 0.25 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
