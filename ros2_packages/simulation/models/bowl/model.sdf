<?xml version="1.0" ?>
<sdf version="1.7">
  <!--
    Composite model.  Link origin = bottom of the base (world floor / table surface).
    All child poses are relative to this bottom-of-bowl origin.

    Part          Geometry             Child pose z   Bottom z   Top z
    ──────────────────────────────────────────────────────────────────
    base          box 0.30×0.30×0.02   0.01           0.00       0.02
    wall_front    box 0.30×0.02×0.08   0.05           0.01       0.09
    wall_back     box 0.30×0.02×0.08   0.05           0.01       0.09
    wall_left     box 0.02×0.30×0.08   0.05           0.01       0.09
    wall_right    box 0.02×0.30×0.08   0.05           0.01       0.09

    Total height  = 0.09 m  (rim top)
    Grip centre z = 0.045 m above link origin  (mid-wall)

    Placement : world pose z = table_surface_z + 0.00 = 0.85
                (origin is the bottom, so it sits directly on the surface)
    Grip world z = 0.85 + 0.045 = 0.895 m

    Visual == Collision per part  ✓  (each part has identical geometry and pose)
  -->
  <model name="bowl">
    <static>false</static>
    <link name="link">

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.002</iyy>
          <izz>0.002</izz>
        </inertia>
      </inertial>

      <!-- Base ─────────────────────────────────────────── -->
      <collision name="base_collision">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.02</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.02</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>

      <!-- Front wall (+Y face) ─────────────────────────── -->
      <collision name="wall_front_collision">
        <pose>0 0.14 0.05 0 0 0</pose>
        <geometry><box><size>0.30 0.02 0.08</size></box></geometry>
      </collision>
      <visual name="wall_front_visual">
        <pose>0 0.14 0.05 0 0 0</pose>
        <geometry><box><size>0.30 0.02 0.08</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>

      <!-- Back wall (-Y face) ──────────────────────────── -->
      <collision name="wall_back_collision">
        <pose>0 -0.14 0.05 0 0 0</pose>
        <geometry><box><size>0.30 0.02 0.08</size></box></geometry>
      </collision>
      <visual name="wall_back_visual">
        <pose>0 -0.14 0.05 0 0 0</pose>
        <geometry><box><size>0.30 0.02 0.08</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>

      <!-- Left wall (-X face) ──────────────────────────── -->
      <collision name="wall_left_collision">
        <pose>-0.14 0 0.05 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.08</size></box></geometry>
      </collision>
      <visual name="wall_left_visual">
        <pose>-0.14 0 0.05 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.08</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>

      <!-- Right wall (+X face) ─────────────────────────── -->
      <collision name="wall_right_collision">
        <pose>0.14 0 0.05 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.08</size></box></geometry>
      </collision>
      <visual name="wall_right_visual">
        <pose>0.14 0 0.05 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.08</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>

    </link>
  </model>
</sdf>